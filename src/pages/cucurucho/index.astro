---
import Layout from '../../layouts/Layout.astro';
const appScreenshot = "/cucurucho.png";
---
<Layout title="Cucurucho POS - Punto de venta simple | NaluSoft">
  <header class="fixed top-0 left-0 right-0 z-50 bg-nalu-cream/85 backdrop-blur-md border-b border-nalu-beige transition-all shadow-sm">
    <div class="max-w-6xl mx-auto px-6 h-20 flex items-center justify-between">
      <a href="/" class="flex items-center gap-3 group">
        <div class="w-10 h-10 rounded-full overflow-hidden border-2 border-nalu-blue/50 group-hover:border-nalu-blue transition-all shadow-md">
          <img src="/logo.png" alt="NaluSoft" class="w-full h-full object-cover" />
        </div>
        <span class="text-xl font-extrabold tracking-wider text-nalu-brown">NALU<span class="text-nalu-blue">SOFT</span></span>
        <span class="hidden md:flex items-center gap-2 ml-4 pl-4 border-l border-nalu-beige">
          <span class="px-3 py-1 text-[10px] font-bold bg-emerald-500/10 text-emerald-800 border border-emerald-500/20 rounded-full">MIT</span>
          <span class="text-[13px] font-bold">Cucurucho</span>
        </span>
      </a>
      <a href="https://cucurucho-olive.vercel.app/" class="px-6 py-2.5 bg-nalu-blue hover:bg-nalu-darkblue text-white font-bold rounded-xl shadow-lg shadow-nalu-blue/25 text-sm transition-all hover:-translate-y-0.5">
        Empezar gratis
      </a>
    </div>
  </header>

  <main class="pt-36 pb-16 px-6">
    <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-[1.15fr_0.85fr] gap-10 items-center">
      <div class="flex flex-col gap-6 animate-fade-in">
        <span class="inline-flex self-start px-4 py-1.5 text-[11px] font-bold tracking-widest bg-white border border-nalu-beige rounded-full text-nalu-brown shadow-sm">
          VENTA SIMPLE • IDEAL HASTA 10 PRODUCTOS
        </span>

        <h1 class="text-[36px] md:text-[54px] font-black leading-[0.9] tracking-tight">
          <span class="block">De heladerías a tu negocio:</span>
          <span class="relative inline-block mt-3 px-1">
            <span class="absolute left-[-3%] right-[-3%] top-[52%] -translate-y-1/2 -rotate-[1.2deg] pointer-events-none">
              <svg viewBox="0 0 320 18" preserveAspectRatio="none" class="w-full h-[0.65em] block overflow-visible">
                <defs><filter id="b1"><feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="1" result="n"/><feDisplacementMap in="SourceGraphic" in2="n" scale="1.5"/></filter></defs>
                <path d="M1.5 10.2 C 8 3.8, 22 2.5, 48 4.2 C 78 6.2, 118 8.1, 158 6.8 C 210 5.2, 265 3.9, 310 5.8 L 318.5 7.2 C 316 11.8, 311 14.2, 301 14 C 260 15.2, 210 16.2, 160 15.4 C 95 14.2, 35 13.8, 3 14.5 Z" fill="#C9A992" filter="url(#b1)"/>
              </svg>
            </span>
            <span class="relative">el punto de venta simple</span>
          </span>
          <span class="block mt-3 text-[22px] md:text-[28px] font-medium opacity-60 leading-none">pensado para negocios de</span>
          <span class="block text-[56px] md:text-[80px] leading-[0.85] mt-2 drop-shadow-[0_6px_18px_rgba(61,35,20,0.15)]">10 productos</span>
        </h1>

        <p class="text-[15px] leading-relaxed text-nalu-lightbrown max-w-[480px] font-medium">
          No es un sistema gigante para supermercados. Es para kioscos, chocolaterías y cafés que quieren vender rápido, sin funciones que nunca van a usar.
        </p>

        <div class="flex gap-3">
          <a href="https://cucurucho-olive.vercel.app/" class="px-8 py-4 bg-nalu-brown hover:bg-black text-white font-bold rounded-xl shadow-xl text-[15px] transition-all hover:-translate-y-1">Empezar gratis →</a>
        </div>
        <p class="text-[11px] opacity-50">Sin tarjeta • Setup en 2 min • Soporte en español</p>
      </div>

      <div class="flex justify-center animate-float">
        <img src={appScreenshot} alt="Cucurucho App" class="w-full max-w-[360px] h-auto rounded-[20px] shadow-[0_24px_60px_rgba(61,35,20,0.18)] border border-white" />
      </div>
    </div>
  </main>
</Layout>