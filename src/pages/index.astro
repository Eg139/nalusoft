---
import Layout from '../layouts/Layout.astro';
---

<Layout title="NaluSoft | Software Factory, Apps & Demos">
    <!-- HEADER / NAVEGACIÓN -->
    <header class="fixed top-0 left-0 right-0 z-50 bg-nalu-cream/85 backdrop-blur-md border-b border-nalu-beige/90 transition-all shadow-sm">
        <div class="max-w-6xl mx-auto px-6 h-20 flex items-center justify-between">
            <!-- Logo y marca -->
            <a href="#" class="flex items-center gap-3 group">
                <div class="w-10 h-10 rounded-full overflow-hidden border-2 border-nalu-blue/50 group-hover:border-nalu-blue group-hover:scale-105 transition-all shadow-md shadow-nalu-blue/10">
                    <img src="/logo.png" alt="NaluSoft Logo - Gata Siamesa" class="w-full h-full object-cover">
                </div>
                <span class="text-xl font-extrabold tracking-wider text-nalu-brown group-hover:opacity-90 transition-opacity">
                    NALU<span class="text-nalu-blue">SOFT</span>
                </span>
            </a>

            <!-- Menú de navegación -->
            <nav class="hidden md:flex items-center gap-8 text-sm font-semibold text-nalu-lightbrown">
                <a href="#servicios" class="hover:text-nalu-blue transition-colors duration-200">Servicios</a>
                <a href="#ecosistema" class="hover:text-nalu-blue transition-colors duration-200">Apps & Demos</a>
                <a href="#planes" class="hover:text-nalu-blue transition-colors duration-200">Planes</a>
                <a href="#soporte" class="hover:text-nalu-blue transition-colors duration-200">Apoyar Proyecto</a>
                <a href="#contacto" class="px-6 py-2.5 bg-nalu-blue hover:bg-nalu-darkblue text-white font-bold rounded-xl transition-all duration-300 shadow-lg shadow-nalu-blue/25 hover:shadow-xl hover:shadow-nalu-blue/40 hover:-translate-y-0.5">
                    Contacto
                </a>
            </nav>
        </div>
    </header>

    <main class="overflow-hidden">
        <!-- HERO SECTION -->
        <section class="pt-36 pb-20 md:pt-48 md:pb-28 px-6 relative">
            <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-nalu-blue/20 rounded-full blur-[120px] pointer-events-none animate-float"></div>
            
            <div class="max-w-4xl mx-auto text-center relative z-10 animate-fade-in">
                <span class="inline-flex items-center gap-2 px-4 py-1.5 mb-6 text-xs font-bold tracking-wide text-nalu-blue bg-white/80 border border-nalu-blue/20 rounded-full shadow-sm">
                    <span class="w-2 h-2 rounded-full bg-nalu-blue animate-pulse"></span>
                    Software Factory & Desarrollo de Autor
                </span>
                
                <h1 class="text-4xl md:text-6xl font-black tracking-tight text-nalu-brown mb-6 leading-[1.15] drop-shadow-xs">
                    Ingeniería de software con <span class="text-transparent bg-clip-text bg-gradient-to-r from-nalu-blue to-nalu-darkblue">precisión y carácter</span>
                </h1>
                
                <p class="text-lg md:text-xl text-nalu-lightbrown/95 mb-10 max-w-2xl mx-auto font-medium leading-relaxed">
                    Diseñamos aplicaciones móviles, sistemas a medida y soluciones digitales de alto rendimiento para impulsar tu visión corporativa.
                </p>
                <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
                    <a href="#ecosistema" class="w-full sm:w-auto px-8 py-4 bg-nalu-blue hover:bg-nalu-darkblue text-white font-bold rounded-xl transition-all duration-300 shadow-xl shadow-nalu-blue/30 text-center hover:-translate-y-1 hover:shadow-2xl hover:shadow-nalu-blue/40">
                        Explorar Apps & Demos
                    </a>
                    <a href="#contacto" class="w-full sm:w-auto px-8 py-4 bg-white/80 hover:bg-white text-nalu-brown border border-nalu-lightbrown/30 font-bold rounded-xl transition-all duration-300 text-center hover:-translate-y-1 shadow-md shadow-nalu-brown/5">
                        Iniciar Proyecto
                    </a>
                </div>
            </div>
        </section>

        <!-- SECCIÓN DE SERVICIOS -->
        <section id="servicios" class="py-24 px-6 border-t border-nalu-beige bg-gradient-to-b from-nalu-beige/30 to-nalu-cream relative">
            <div class="max-w-6xl mx-auto">
                <div class="text-center mb-16">
                    <h2 class="text-3xl md:text-4xl font-black text-nalu-brown mb-3">Nuestras Capacidades</h2>
                    <p class="text-nalu-lightbrown max-w-xl mx-auto text-base font-medium">Desarrollo integral enfocado en escalabilidad, diseño de interfaz superior y rendimiento óptimo.</p>
                </div>
                
                <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                    <!-- Tarjeta 1 -->
                    <div class="p-8 rounded-2xl bg-white/90 backdrop-blur-md border border-nalu-beige/80 hover:border-nalu-blue shadow-lg shadow-nalu-brown/5 hover:shadow-2xl hover:shadow-nalu-blue/15 transition-all duration-300 group hover:-translate-y-2 flex flex-col justify-between">
                        <div>
                            <div class="w-14 h-14 bg-nalu-blue/10 border border-nalu-blue/20 rounded-2xl flex items-center justify-center text-nalu-blue mb-6 group-hover:bg-nalu-blue group-hover:text-white transition-all duration-300 shadow-md shadow-nalu-blue/10 group-hover:scale-110">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
                                </svg>
                            </div>
                            <h3 class="text-xl font-bold text-nalu-brown mb-3">Apps Móviles Nativas</h3>
                            <p class="text-nalu-brown/80 text-sm leading-relaxed font-medium">Creación de aplicaciones para iOS y Android de alta fluidez, integrando geolocalización, biometría y arquitectura sólida.</p>
                        </div>
                    </div>

                    <!-- Tarjeta 2 -->
                    <div class="p-8 rounded-2xl bg-white/90 backdrop-blur-md border border-nalu-beige/80 hover:border-nalu-blue shadow-lg shadow-nalu-brown/5 hover:shadow-2xl hover:shadow-nalu-blue/15 transition-all duration-300 group hover:-translate-y-2 flex flex-col justify-between">
                        <div>
                            <div class="w-14 h-14 bg-nalu-blue/10 border border-nalu-blue/20 rounded-2xl flex items-center justify-center text-nalu-blue mb-6 group-hover:bg-nalu-blue group-hover:text-white transition-all duration-300 shadow-md shadow-nalu-blue/10 group-hover:scale-110">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                                </svg>
                            </div>
                            <h3 class="text-xl font-bold text-nalu-brown mb-3">Sistemas a Medida</h3>
                            <p class="text-nalu-brown/80 text-sm leading-relaxed font-medium">Desarrollo de software empresarial, paneles de control y sistemas POS adaptados a procesos operativos complejos.</p>
                        </div>
                    </div>

                    <!-- Tarjeta 3 -->
                    <div class="p-8 rounded-2xl bg-white/90 backdrop-blur-md border border-nalu-beige/80 hover:border-nalu-blue shadow-lg shadow-nalu-brown/5 hover:shadow-2xl hover:shadow-nalu-blue/15 transition-all duration-300 group hover:-translate-y-2 flex flex-col justify-between">
                        <div>
                            <div class="w-14 h-14 bg-nalu-blue/10 border border-nalu-blue/20 rounded-2xl flex items-center justify-center text-nalu-blue mb-6 group-hover:bg-nalu-blue group-hover:text-white transition-all duration-300 shadow-md shadow-nalu-blue/10 group-hover:scale-110">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
                                </svg>
                            </div>
                            <h3 class="text-xl font-bold text-nalu-brown mb-3">Infraestructura Cloud</h3>
                            <p class="text-nalu-brown/80 text-sm leading-relaxed font-medium">Despliegues seguros, optimización de velocidad web y gestión de servidores preparados para alta concurrencia.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- SECCIÓN DE ECOSISTEMA (APPS, DEMOS Y SOFTWARE) -->
        <section id="ecosistema" class="py-24 px-6 border-t border-nalu-beige">
            <div class="max-w-6xl mx-auto">
                <div class="text-center mb-16">
                    <h2 class="text-3xl md:text-4xl font-black text-nalu-brown mb-3">Apps, Demos & Software Gratuito</h2>
                    <p class="text-nalu-lightbrown max-w-xl mx-auto text-base font-medium">Explora nuestros productos comerciales, pruébalos en vivo o descarga nuestras herramientas libres.</p>
                </div>
                
                <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                    <!-- 1. Apps & Soluciones Premium -->
                    <div class="p-8 rounded-2xl bg-white/95 backdrop-blur-md border border-nalu-beige/80 hover:border-nalu-blue shadow-lg shadow-nalu-brown/5 hover:shadow-2xl hover:shadow-nalu-blue/15 transition-all duration-300 flex flex-col justify-between relative overflow-hidden group hover:-translate-y-2">
                        <div class="absolute top-0 right-0 w-32 h-32 bg-nalu-blue/10 rounded-bl-full pointer-events-none group-hover:scale-125 transition-transform duration-500"></div>
                        <div>
                            <span class="px-3.5 py-1 text-xs font-bold bg-nalu-blue/10 text-nalu-blue border border-nalu-blue/20 rounded-full inline-block mb-4 shadow-xs">Apps & Comercial</span>
                            <h3 class="text-2xl font-bold text-nalu-brown mb-3">Sistemas POS & Apps</h3>
                            <p class="text-nalu-brown/80 text-sm mb-6 leading-relaxed font-medium">Software cerrado, probado en entornos reales, diseñado para comercios y organizaciones que exigen estabilidad total.</p>
                        </div>
                        <div>
                            <a href="#planes" class="inline-flex items-center gap-2 text-sm font-bold text-nalu-blue hover:text-nalu-darkblue transition-colors group-hover:translate-x-1.5 duration-200">
                                Ver modelos de contratación &rarr;
                            </a>
                        </div>
                    </div>

                    <!-- 2. Demos Interactivas: SaaS Multi-modo (superPOS) -->
                    <div class="p-8 rounded-2xl bg-white/95 backdrop-blur-md border border-nalu-beige/80 hover:border-amber-600 shadow-lg shadow-nalu-brown/5 hover:shadow-2xl hover:shadow-amber-500/15 transition-all duration-300 flex flex-col justify-between relative overflow-hidden group hover:-translate-y-2">
                        <div class="absolute top-0 right-0 w-32 h-32 bg-amber-500/10 rounded-bl-full pointer-events-none group-hover:scale-125 transition-transform duration-500"></div>
                        <div>
                            <span class="px-3.5 py-1 text-xs font-bold bg-amber-500/10 text-amber-800 border border-amber-500/20 rounded-full inline-block mb-4 shadow-xs">SaaS Multi-modo (Demo)</span>
                            <h3 class="text-2xl font-bold text-nalu-brown mb-3">superPOS / Demo Avanzada</h3>
                            <p class="text-nalu-brown/80 text-sm mb-6 leading-relaxed font-medium">Plataforma SaaS con arquitectura flexible. Explora en vivo cómo muta su interfaz y lógica operativa entre heladerías y maxiquioscos.</p>
                        </div>
                        <div>
                            <a href="/superpos" class="inline-flex items-center gap-2 text-sm font-bold text-amber-800 hover:text-amber-900 transition-colors group-hover:translate-x-1.5 duration-200">
                                Ver detalles y demo &rarr;
                            </a>
                        </div>
                    </div>

                    <!-- 3. Software Libre / Cucurucho -->
                    <div class="p-8 rounded-2xl bg-white/95 backdrop-blur-md border border-nalu-beige/80 hover:border-emerald-600 shadow-lg shadow-nalu-brown/5 hover:shadow-2xl hover:shadow-emerald-500/15 transition-all duration-300 flex flex-col justify-between relative overflow-hidden group hover:-translate-y-2">
                        <div class="absolute top-0 right-0 w-32 h-32 bg-emerald-500/10 rounded-bl-full pointer-events-none group-hover:scale-125 transition-transform duration-500"></div>
                        <div>
                            <span class="px-3.5 py-1 text-xs font-bold bg-emerald-500/10 text-emerald-800 border border-emerald-500/20 rounded-full inline-block mb-4 shadow-xs">Software Libre (MIT)</span>
                            <h3 class="text-2xl font-bold text-nalu-brown mb-3">Cucurucho POS</h3>
                            <p class="text-nalu-brown/80 text-sm mb-6 leading-relaxed font-medium">POS minimalista offline-first en uso activo para mostrador rápido, control de turnos y exportación a Excel sin comisiones.</p>
                        </div>
                        <div>
                            <!-- AQUÍ COLOCAS EL DOMINIO DEFINITIVO DE TU APP -->
                            <a href="/cucurucho" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-sm font-bold text-emerald-800 hover:text-emerald-900 transition-colors group-hover:translate-x-1.5 duration-200">
                                Ir al sistema &rarr;
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </section>


        <!-- SECCIÓN DE PLANES Y OPCIONES DE CONTRATACIÓN -->
        <section id="planes" class="py-24 px-6 border-t border-nalu-beige bg-gradient-to-b from-nalu-cream to-nalu-beige/30">
            <div class="max-w-6xl mx-auto">
                <div class="text-center mb-16">
                    <h2 class="text-3xl md:text-4xl font-black text-nalu-brown mb-3">Modelos de Adquisición</h2>
                    <p class="text-nalu-lightbrown max-w-xl mx-auto text-base font-medium">Elegí el esquema que mejor se adapte a tu comercio: suscripción mensual activa o compra del proyecto completo.</p>
                </div>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
                    <!-- Opción 1: Suscripción Mensual (SaaS) -->
                    <div class="p-8 rounded-2xl bg-white/95 backdrop-blur-md border border-nalu-beige shadow-xl shadow-nalu-brown/5 flex flex-col justify-between">
                        <div>
                            <span class="px-3.5 py-1 text-xs font-bold bg-nalu-blue/10 text-nalu-blue border border-nalu-blue/20 rounded-full inline-block mb-4">Suscripción Mensual (SaaS)</span>
                            <h3 class="text-2xl font-bold text-nalu-brown mb-2">Plan Comercial POS</h3>
                            <div class="text-3xl font-black text-nalu-blue mb-4">$30.000 – $70.000 <span class="text-xs font-semibold text-nalu-lightbrown">ARS / mes</span></div>
                            <p class="text-nalu-brown/80 text-sm mb-6 leading-relaxed font-medium">Ideal para comercios locales. Acceso inmediato a la plataforma con modos específicos para heladerías y maxiquioscos, con soporte y actualizaciones continuas.</p>
                            
                            <ul class="space-y-3 mb-8 text-sm text-nalu-brown/90 font-medium">
                                <li class="flex items-center gap-2">
                                    <svg class="w-4 h-4 text-nalu-blue shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                                    Modo Heladería / Maxiquiosco integrado
                                </li>
                                <li class="flex items-center gap-2">
                                    <svg class="w-4 h-4 text-nalu-blue shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                                    Actualizaciones y soporte técnico mensual
                                </li>
                                <li class="flex items-center gap-2">
                                    <svg class="w-4 h-4 text-nalu-blue shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                                    Sin costos de instalación inicial elevados
                                </li>
                            </ul>
                        </div>
                        <div>
                            <a href="#contacto" class="w-full block py-3.5 bg-nalu-beige/70 hover:bg-nalu-beige text-nalu-brown font-bold rounded-xl text-center transition-all border border-nalu-lightbrown/20 shadow-xs">
                                Contratar Suscripción
                            </a>
                        </div>
                    </div>

                    <!-- Opción 2: Venta de Proyecto Completo / Software Mínimo -->
                    <div class="p-8 rounded-2xl bg-white/95 backdrop-blur-md border-2 border-nalu-blue shadow-xl shadow-nalu-blue/10 flex flex-col justify-between relative overflow-hidden">
                        <div class="absolute top-0 right-0 bg-nalu-blue text-white text-[10px] font-black uppercase px-4 py-1 rounded-bl-xl tracking-wider">Proyecto Entero</div>
                        <div>
                            <span class="px-3.5 py-1 text-xs font-bold bg-nalu-blue/10 text-nalu-blue border border-nalu-blue/20 rounded-full inline-block mb-4">Adquisición de Licencia Base</span>
                            <h3 class="text-2xl font-bold text-nalu-brown mb-2">Compra de Software POS</h3>
                            <div class="text-3xl font-black text-nalu-blue mb-4">Desde USD 500</div>
                            <p class="text-nalu-brown/80 text-sm mb-6 leading-relaxed font-medium">Pensado para emprendedores, agencias o negocios que buscan adquirir el proyecto entero o el software base para despliegue propio y personalización completa.</p>
                            
                            <ul class="space-y-3 mb-8 text-sm text-nalu-brown/90 font-medium">
                                <li class="flex items-center gap-2">
                                    <svg class="w-4 h-4 text-nalu-blue shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                                    Entrega de software base / código estructurado
                                </li>
                                <li class="flex items-center gap-2">
                                    <svg class="w-4 h-4 text-nalu-blue shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                                    Opción de expandir rubros o módulos a medida
                                </li>
                                <li class="flex items-center gap-2">
                                    <svg class="w-4 h-4 text-nalu-blue shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                                    Independencia operativa y despliegue dedicado
                                </li>
                            </ul>
                        </div>
                        <div>
                            <a href="#contacto" class="w-full block py-3.5 bg-nalu-blue hover:bg-nalu-darkblue text-white font-bold rounded-xl text-center transition-all shadow-md shadow-nalu-blue/25">
                                Consultar Compra de Software
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- SECCIÓN DE CONTACTO -->
        <section id="contacto" class="py-24 px-6 border-t border-nalu-beige bg-nalu-beige/30">
            <div class="max-w-3xl mx-auto text-center">
                <h2 class="text-3xl md:text-4xl font-black text-nalu-brown mb-4">Hagamos realidad tu próximo desarrollo</h2>
                <p class="text-nalu-lightbrown mb-8 text-base font-medium">Conversemos sobre arquitectura, plazos y requerimientos para tu proyecto.</p>
                <div class="inline-flex flex-col sm:flex-row gap-4 items-center justify-center p-6 bg-white/90 backdrop-blur-md border border-nalu-beige rounded-2xl w-full shadow-xl shadow-nalu-brown/5 hover:shadow-2xl transition-all">
                    <span class="text-nalu-brown font-semibold text-sm">Canal de contacto directo:</span>
                    <a href="mailto:nalusoft.dev@gmail.com?subject=Consulta%20Software%20-%20NaluSoft" class="text-nalu-blue hover:underline font-bold text-sm">nalusoft.dev@gmail.com</a>
                </div>
            </div>
        </section>
    </main>

    <!-- FOOTER -->
    <footer class="py-8 px-6 border-t border-nalu-beige bg-nalu-cream text-center text-xs text-nalu-lightbrown font-medium">
        <p>&copy; 2026 NaluSoft. Identidad y desarrollo con respaldo técnico.</p>
    </footer>

    <!-- SCRIPT PARA COPIAR ALIAS CON SWEETALERT2 -->
    <script is:inline>
        function copiarAlias(alias) {
            navigator.clipboard.writeText(alias).then(() => {
                Swal.fire({
                    icon: 'success',
                    title: '¡Alias copiado!',
                    text: 'Copiado al portapapeles: ' + alias + '. ¡Muchas gracias por apoyar a NaluSoft!',
                    timer: 3000,
                    showConfirmButton: false,
                    background: '#F4EFEA',
                    color: '#2D231E'
                });
            }).catch(err => {
                console.error('Error al copiar: ', err);
            });
        }
    </script>
</Layout>